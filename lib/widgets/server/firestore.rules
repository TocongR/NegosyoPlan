rules_version = '2';

// NegosyoPlan demo rules.
// Each phone signs in anonymously and can only read and write its own
// application: applications/{uid} and applications/{uid}/files/{fileId}.
// OLEDIPO staff read the data in the Firebase console for now.
service cloud.firestore {
  match /databases/{database}/documents {
    match /applications/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /files/{fileId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
